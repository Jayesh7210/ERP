              const Text('My Referrals', style: TextStyle(fontSize: 15, fontWeight: FontWeight.bold, color: ClientColors.textDark)),
              TextButton(onPressed: () {}, child: const Text('View All', style: TextStyle(fontSize: 12, color: ClientColors.primary))),
            ],
