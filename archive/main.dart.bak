                  ),
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.end,
                    children: [
                      const Text('Earned', style: TextStyle(fontSize: 10, color: ClientColors.textMuted)),
                      Text('₹${ref['earned'] ?? 0}', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 13, color: ClientColors.primary)),
                    ],
                  ),
                ],
              ),
            );
          }),
        ],
      ),
    );
  }

  // ===========================================================================
  // SCREEN 5: SETTLEMENT TAB (Tab 4)
  // ===========================================================================
  Widget _buildSettlementTab() {
    final unsold = _totalDispatchedBottles - _settlementSoldBottles;
    final soldAmt = (_settlementSoldBottles * _bottleUnitPrice).toInt();
    final unsoldVal = (unsold * _bottleUnitPrice).toInt();
    final totalVal = (_totalDispatchedBottles * _bottleUnitPrice).toInt();

    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Today's Dispatch Card
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(12), border: Border.all(color: ClientColors.border)),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text("TODAY'S DISPATCH", style: TextStyle(fontSize: 10, color: ClientColors.textMuted, fontWeight: FontWeight.bold)),
                        SizedBox(height: 2),
                        Text('10 Bottles', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: ClientColors.textDark)),
                      ],
                    ),
                    Column(
                      crossAxisAlignment: CrossAxisAlignment.end,
                      children: [
                        const Text('TOTAL VALUE', style: TextStyle(fontSize: 10, color: ClientColors.textMuted, fontWeight: FontWeight.bold)),
                        const SizedBox(height: 2),
                        Text('₹$totalVal', style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: ClientColors.primary)),
                      ],
                    ),
                  ],
                ),
                const SizedBox(height: 10),
                const Row(
                  children: [
                    Icon(Icons.verified, color: Colors.green, size: 14),
                    SizedBox(width: 4),
                    Text('Accepted & Verified', style: TextStyle(fontSize: 11, color: Colors.green, fontWeight: FontWeight.bold)),
                  ],
                ),
              ],
            ),
          ),
          const SizedBox(height: 16),

          // Interactive Bottles Sold Counter
          const Text('Bottles Sold', style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold, color: ClientColors.textDark)),
          const SizedBox(height: 6),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
            decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(12), border: Border.all(color: ClientColors.border)),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                IconButton(
                  icon: const Icon(Icons.remove_circle_outline, color: ClientColors.primary, size: 28),
                  onPressed: () {
                    if (_settlementSoldBottles > 0) {
                      setState(() {
                        _settlementSoldBottles--;
                        _cashHandoverCtrl.text = '${(_settlementSoldBottles * _bottleUnitPrice).toInt()}';
                      });
                    }
                  },
                ),
                Text('$_settlementSoldBottles', style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: ClientColors.textDark)),
                IconButton(
                  icon: const Icon(Icons.add_circle_outline, color: ClientColors.primary, size: 28),
                  onPressed: () {
                    if (_settlementSoldBottles < _totalDispatchedBottles) {
                      setState(() {
                        _settlementSoldBottles++;
                        _cashHandoverCtrl.text = '${(_settlementSoldBottles * _bottleUnitPrice).toInt()}';
                      });
                    }
                  },
                ),
              ],
            ),
          ),
          const SizedBox(height: 12),

          // Sold Amount & Unsold Value Card
          Container(
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(12), border: Border.all(color: ClientColors.border)),
            child: Column(
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Row(
                      children: [
                        const Icon(Icons.check_circle_outline, color: Colors.green, size: 16),
                        const SizedBox(width: 6),
                        Text('Sold Amount ($_settlementSoldBottles)', style: const TextStyle(fontSize: 12, color: ClientColors.textDark)),
                      ],
                    ),
                    Text('₹$soldAmt', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 13, color: ClientColors.textDark)),
                  ],
                ),
                const SizedBox(height: 8),
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Row(
                      children: [
                        const Icon(Icons.shopping_bag_outlined, color: Colors.orange, size: 16),
                        const SizedBox(width: 6),
                        Text('Unsold Value ($unsold)', style: const TextStyle(fontSize: 12, color: ClientColors.textDark)),
                      ],
                    ),
                    Text('₹$unsoldVal', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 13, color: ClientColors.textDark)),
                  ],
                ),
              ],
            ),
          ),
          const SizedBox(height: 14),

          // Reconciliation Tally Card (Copper Background)
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: const Color(0xFFB8501E),
              borderRadius: BorderRadius.circular(14),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Text('Reconciliation Tally', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 13)),
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                      decoration: BoxDecoration(color: Colors.black.withValues(alpha: 0.2), borderRadius: BorderRadius.circular(6)),
                      child: const Row(
                        children: [
                          Icon(Icons.circle, color: Color(0xFF69F0AE), size: 6),
                          SizedBox(width: 4),
                          Text('Tally Complete', style: TextStyle(color: Colors.white, fontSize: 9, fontWeight: FontWeight.bold)),
                        ],
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 14),
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceAround,
                  children: [
                    _tallyCol('Accepted', '₹$totalVal'),
                    const Text('=', style: TextStyle(color: Colors.white70, fontSize: 16, fontWeight: FontWeight.bold)),
                    _tallyCol('Sold', '₹$soldAmt'),
                    const Text('+', style: TextStyle(color: Colors.white70, fontSize: 16, fontWeight: FontWeight.bold)),
                    _tallyCol('Unsold', '₹$unsoldVal'),
                  ],
                ),
                const SizedBox(height: 12),
                const Divider(color: Colors.white24),
                const Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text('Difference', style: TextStyle(color: Colors.white70, fontSize: 11)),
                    Text('₹0', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 14)),
                  ],
                ),
              ],
            ),
          ),
          const SizedBox(height: 14),

          // Cash Handover Amount
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
            decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(10), border: Border.all(color: ClientColors.border)),
            child: Row(
              children: [
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text('Cash Handover Amount', style: TextStyle(fontSize: 10, color: ClientColors.textMuted)),
                      Row(
                        children: [
                          const Text('₹ ', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: ClientColors.textDark)),
                          Expanded(
                            child: TextField(
                              controller: _cashHandoverCtrl,
                              keyboardType: TextInputType.number,
                              style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: ClientColors.textDark),
                              decoration: const InputDecoration(border: InputBorder.none, isDense: true, contentPadding: EdgeInsets.zero),
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
                TextButton(
                  onPressed: () => setState(() => _cashHandoverCtrl.text = '$soldAmt'),
                  child: const Text('MAX', style: TextStyle(fontWeight: FontWeight.bold, color: ClientColors.primary)),
                ),
              ],
            ),
          ),
          const SizedBox(height: 16),

          // Action Buttons: Return QR & Complete Settlement
          Row(
            children: [
              OutlinedButton.icon(
                onPressed: () {
                  setState(() => _returnQrVerified = true);
                  ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('✅ Return QR scanned for $unsold unsold bottles.')));
                },
                icon: const Icon(Icons.qr_code, size: 16, color: ClientColors.textDark),
                label: Text('Return QR ($unsold)', style: const TextStyle(fontSize: 12, color: ClientColors.textDark)),
                style: OutlinedButton.styleFrom(
                  backgroundColor: Colors.white,
                  side: const BorderSide(color: ClientColors.border),
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 12),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                ),
              ),
              const SizedBox(width: 8),
              Expanded(
                child: ElevatedButton(
                  onPressed: _completeSettlement,
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF8B3A0D),
                    foregroundColor: Colors.white,
                    padding: const EdgeInsets.symmetric(vertical: 12),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                  ),
                  child: const Text('Complete Settlement', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 13)),
                ),
              ),
            ],
          ),
          const SizedBox(height: 22),

          // Previous Settlements Section
          const Text('Previous Settlements', style: TextStyle(fontSize: 15, fontWeight: FontWeight.bold, color: ClientColors.textDark)),
          const SizedBox(height: 10),
          ..._settlementHistory.map((s) {
            return Container(
              margin: const EdgeInsets.only(bottom: 8),
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
              decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(10), border: Border.all(color: ClientColors.border)),
              child: Row(
                children: [
                  const Icon(Icons.history, color: ClientColors.textMuted, size: 18),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(s['date_label'] ?? 'Previous Day', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 12, color: ClientColors.textDark)),
                        Text('${s['bottles_dispatched'] ?? 10} Bottles', style: const TextStyle(fontSize: 11, color: ClientColors.textMuted)),
                      ],
                    ),
                  ),
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.end,
                    children: [
                      Text('₹${s['total_value'] ?? 3510}', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 13, color: ClientColors.textDark)),
                      const Row(
                        children: [
                          Icon(Icons.circle, color: Colors.green, size: 6),
                          SizedBox(width: 4),
                          Text('Tally Zero', style: TextStyle(fontSize: 10, color: Colors.green, fontWeight: FontWeight.w600)),
                        ],
                      ),
                    ],
                  ),
                ],
              ),
            );
          }),
        ],
      ),
    );
  }

  Widget _tallyCol(String title, String val) {
    return Column(
      children: [
        Text(title, style: const TextStyle(color: Colors.white70, fontSize: 10)),
        const SizedBox(height: 2),
        Text(val, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 14)),
      ],
    );
  }

  Widget _infoRow(String label, String value) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 3),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label, style: const TextStyle(fontSize: 12, color: ClientColors.textMuted)),
          Text(value, style: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: ClientColors.textDark)),
        ],
      ),
    );
  }
}